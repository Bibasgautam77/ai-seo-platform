# --- Database ---
POSTGRES_USER=seo_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=seo_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://seo_admin:change_me@postgres:5432/seo_platform

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- Vector DB (Qdrant) ---
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_COLLECTION=content_embeddings

# --- LLM Provider ---
# One of: anthropic | openai
LLM_PROVIDER=anthropic
LLM_API_KEY=your_api_key_here
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change_me_to_a_random_string
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Content Decay Monitoring ---
DECAY_CHECK_INTERVAL_HOURS=24
DECAY_TRAFFIC_DROP_THRESHOLD_PCT=20
